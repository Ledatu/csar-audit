{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::__BUCKET__",
        "arn:aws:s3:::__BUCKET__/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyHistoryDeletion",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    },
    {
      "Sid": "DenyUnconditionalWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        }
      }
    },
    {
      "Sid": "ArchiveWriterVerification",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "__WRITER_ID__"
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    },
    {
      "Sid": "ArchiveReader",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "__READER_ID__"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    },
    {
      "Sid": "ArchiveCatalogRecovery",
      "Effect": "Allow",
      "Principal": {
        "CanonicalUser": "__READER_ID__"
      },
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReaderCannotWrite",
      "Effect": "Deny",
      "Principal": {
        "CanonicalUser": "__READER_ID__"
      },
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    }
  ]
}
